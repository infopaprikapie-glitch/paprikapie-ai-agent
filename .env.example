# Copy this file to .env and fill in your real values. Never commit .env to GitHub.

# Get this from console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Make up any random string yourself — you'll enter this same value in Meta's webhook setup screen
WHATSAPP_VERIFY_TOKEN=paprikapie_verify_123

# From Meta Business -> WhatsApp -> API Setup, after you set up the Cloud API
WHATSAPP_TOKEN=your_meta_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

PORT=3000
